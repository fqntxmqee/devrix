# Devrix 环境变量配置
# 复制此文件为 .env 并填入实际值

# ===== 应用配置 =====
DEVRIX_CONFIG=devrix.yaml  # 配置文件路径

# ===== 认证配置 =====
DEVRIX_AUTH_SECRET=change-me-in-production
DEVRIX_AUTH_TOKEN_EXPIRY=24h
DEVRIX_AUTH_ISSUER=devrix

# ===== 会话配置 =====
DEVRIX_SESSION_DIR=~/.devrix/sessions
DEVRIX_SESSION_TIMEOUT=30m

# ===== 权限配置 =====
DEVRIX_PERMISSION_TIMEOUT=60s

# ===== 限流配置 =====
DEVRIX_RATE_LIMIT_RPM=100
DEVRIX_RATE_LIMIT_BURST=10
DEVRIX_RATE_LIMIT_ENABLED=true

# ===== 飞书配置 =====
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_BOT_NAME=Devrix
FEISHU_DOMAIN=
FEISHU_ENCRYPT_KEY=
FEISHU_PORT=8080
FEISHU_USE_WEBHOOK=false

# ===== 日志配置 =====
DEVRIX_LOG_LEVEL=info
DEVRIX_LOG_FORMAT=json
