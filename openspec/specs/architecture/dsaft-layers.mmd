graph LR
    subgraph LAYERS["DSAFT 五层架构 — 从抽象到实现"]
        direction TB

        D["<b>D 层 — Domain 领域</b><br/>7 域 + ORCH<br/>稳定，对应 internal/layers/ 一级目录"]
        S["<b>S 层 — Scenario 场景</b><br/>58 场景<br/>域内模块，对应二级包目录"]
        A["<b>A 层 — Activity 活动</b><br/>77 活动 / openspec/a-registry.md<br/>业务动作：输入 → 输出 → 状态变更"]
        F["<b>F 层 — Function Point 功能点</b><br/>98 功能点 / openspec/f-registry.md<br/>最小可测试逻辑单元"]
        T["<b>T 层 — Test Point 测试点</b><br/>130+ 测试点 / openspec/t-registry.md<br/>编号: D{X}-S{X}-A{XX}-T{NN}"]

        D -->|"包含"| S
        S -->|"定义"| A
        A -->|"编排"| F
        F -->|"验证"| T
    end

    subgraph EXAMPLE["示例: D2-S1 (PEV) 完整链路"]
        direction TB
        ED["D2: Context Engine"]
        ES["D2-S1: PEV"]
        EA["D2-S1-A01: ExecutePEV<br/>输入: ctx, session, message<br/>输出: &lt;-chan *EngineEvent"]
        EF["D2-S1-A01-F01: Process<br/>D2-S1-A01-F02: EmitEngineEvent<br/>D2-S1-A01-F03: RunPEVCycle"]
        ET["D2-S1-A01-T01: PEV Execute LLM 流输出<br/>D2-S1-A02-T02: Verify basic 模式<br/>D2-S1-A03-T07: Milestone 按序执行"]
        ED --> ES --> EA --> EF --> ET
    end

    classDef domain fill:#e1f5fe,stroke:#0288d1,stroke-width:2px
    classDef scenario fill:#b3e5fc,stroke:#0288d1
    classDef activity fill:#fff9c4,stroke:#fbc02d
    classDef function fill:#ffccbc,stroke:#e64a19
    classDef test fill:#c8e6c9,stroke:#388e3c

    class D,ED domain
    class S,ES scenario
    class A,EA activity
    class F,EF function
    class T,ET test
