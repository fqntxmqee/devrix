sequenceDiagram
    actor User as 👤 用户
    participant IM as D1: Adapter (飞书/CLI)
    participant GW as D1: Gateway
    participant H as D2: Harness
    participant QL as D2: QueryLoop
    participant CMP as D2: Compression
    participant MEM as D2: Memory
    participant LLM as D3: LLM Gateway
    participant DLG as D4: Delegate
    participant WK as D4: Worker
    participant WV as ORCH: WaveScheduler
    participant FL as ORCH: ExecutionFlowHub
    participant OBS as D5: Observability

    rect rgb(225, 245, 254)
        Note over User,GW: 链路1: 消息入站 → 上下文处理 → LLM 调用
        User->>IM: 发送消息
        IM->>GW: RouteInbound(message)
        GW->>GW: ManageSession (D1-S1-A01)
        GW->>H: Process(ctx, session, message)
        H->>H: BootstrapSession (D2-S9-A01)
        H->>H: AssembleSystemPrompt (D2-S9-A02)
        H->>H: FilterToolPool (D2-S9-A03)
        H->>QL: RunQueryLoop (D2-S10-A01)
        QL->>MEM: LoadOrInit (D2-S3-A01)
        QL->>CMP: RunPipeline (D2-S2-A01)
        QL->>LLM: StreamChat (D3-S1-A01)
        LLM-->>QL: <-chan chunk
        QL-->>GW: <-chan *EngineEvent
        GW->>IM: SendOutbound (D1-S2-A02)
        IM-->>User: 飞书卡片 / CLI 输出
    end

    rect rgb(232, 245, 233)
        Note over GW,FL: 链路2: Delegate / Fork → Worker → Join
        GW->>DLG: DelegateTask (D4-S10-A01)
        DLG->>DLG: ForkAgent (D4-S3-A01)
        DLG->>WK: CreateWorker(spec)
        WK->>QL: RunQueryLoop (独立 session)
        QL->>LLM: StreamChat (独立 context)
        LLM-->>QL: chunk stream
        WK->>FL: PublishFlow (ORCH-S2-A01)
        FL->>GW: DispatchToIM (进度卡片)
        GW-->>User: Worker 进度更新
        WK-->>DLG: DelegateResult
        DLG->>DLG: JoinAgents (D4-S3-A02)
        DLG-->>GW: merged_result
        GW-->>User: 汇总输出
    end

    rect rgb(255, 243, 224)
        Note over GW,WV: 链路3: Wave Scheduler DAG 调度
        GW->>WV: ScheduleWave(session_id, task_graph)
        loop 每轮调度 (Dispatch Loop)
            WV->>WV: GuardConflict (ORCH-S3-A03)
            WV->>WV: ResolveContext (ORCH-S3-A02)
            WV->>WV: DispatchWorker(task_node)
            WK->>QL: RunQueryLoop
            QL->>LLM: StreamChat
            WK->>FL: PublishFlow (ORCH-S2-A01)
            FL->>GW: DispatchToIM (双区块卡片)
            WK-->>WV: Artifact
            WV->>WV: ReleaseSlot
        end
        WV-->>GW: wave_completed (汇总)
        GW-->>User: 完成卡片
    end

    rect rgb(255, 235, 238)
        Note over LLM,OBS: 链路4: 熔断与重试
        QL->>LLM: StreamWithBreaker (D3-S2-A01)
        LLM->>LLM: BeforeCall (D3-S3-A01)
        alt 熔断器关闭
            LLM->>LLM: CallModel (D3-S1-A01)
        else 熔断器打开
            LLM-->>QL: CircuitOpen error
            LLM->>LLM: ExecuteRetry (D3-S4-A01)
        end
        LLM->>LLM: AfterCall (D3-S3-A02)
        LLM-->>QL: response / error
    end

    rect rgb(243, 229, 245)
        Note over OBS,D6: 链路5: 全链路观测 + 演化探针
        OBS->>QL: CreateSpan (D5-S1-A01)
        OBS->>GW: RecordMetric (D5-S2-A01)
        OBS->>LLM: LogRecord (D5-S3-A01)
        D6->>QL: CompressionRecallProbe
        D6->>QL: ToolAccuracyProbe
        D6->>WV: PathRegressionProbe
        D6->>GW: LayerViolationProbe
    end
